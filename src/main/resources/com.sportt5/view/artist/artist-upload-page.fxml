<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sportt5.controller.components.UploadController"
            visible="false" managed="false"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="home-scroll">
    <VBox spacing="18.0" styleClass="admin-body">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT">
            <Label text="Upload Music" styleClass="admin-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Submit" styleClass="upload-button" onAction="#handleSubmit"/>
        </HBox>

        <!-- Album selector -->
        <VBox spacing="14.0" styleClass="admin-panel">
            <Label text="Album" styleClass="panel-title"/>
            <ComboBox fx:id="albumCombo" promptText="Select album..." maxWidth="Infinity"
                      styleClass="dark-combo"/>
        </VBox>

        <!-- Song rows container -->
        <VBox fx:id="songRowsContainer" spacing="14.0" styleClass="admin-panel">
            <HBox alignment="CENTER_LEFT">
                <Label text="Tracks" styleClass="panel-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Add Track" styleClass="add-track-button" onAction="#handleAddTrack"/>
            </HBox>
            <!-- Song rows injected here by controller -->
        </VBox>

    </VBox>
</ScrollPane>