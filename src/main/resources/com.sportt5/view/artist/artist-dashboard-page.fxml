<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sportt5.controller.pages.ArtistDashboardController"
            visible="false" managed="false"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="home-scroll">
    <VBox spacing="18.0" styleClass="admin-body">

        <!-- ── Header ── -->
        <HBox alignment="CENTER_LEFT" spacing="18.0">
            <VBox spacing="5.0">
                <Label text="Artist Dashboard" styleClass="admin-title" />
                <Label fx:id="lblSubtitle"
                       text="Good morning. Here's what's happening with your music today."
                       styleClass="admin-subtitle" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnUploadMusic" text="⊕  Upload New Music"
                    styleClass="upload-button" />
        </HBox>

        <!-- ── Metric Cards ── -->
        <HBox spacing="18.0">

            <!-- Revenue -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="metric-card">
                <HBox alignment="CENTER_LEFT">
                    <StackPane prefWidth="34.0" prefHeight="30.0" styleClass="metric-icon revenue-icon">
                        <Label text="▣" />
                    </StackPane>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblTrendRevenue" text="—" styleClass="trend-up" />
                </HBox>
                <Label text="TOTAL REVENUE" styleClass="metric-label" />
                <Label fx:id="lblTotalRevenue" text="Loading..." styleClass="metric-value" />
                <HBox fx:id="revenueBarChart" alignment="BOTTOM_LEFT" spacing="6.0" styleClass="bar-chart">
                    <Region prefWidth="18.0" prefHeight="16.0" />
                    <Region prefWidth="18.0" prefHeight="25.0" />
                    <Region prefWidth="18.0" prefHeight="20.0" />
                    <Region prefWidth="18.0" prefHeight="34.0" />
                    <Region prefWidth="18.0" prefHeight="28.0" />
                    <Region prefWidth="18.0" prefHeight="39.0" />
                </HBox>
            </VBox>

            <!-- Monthly Listeners -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="metric-card">
                <HBox alignment="CENTER_LEFT">
                    <StackPane prefWidth="34.0" prefHeight="30.0" styleClass="metric-icon listener-icon">
                        <Label text="♙" />
                    </StackPane>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblTrendListeners" text="—" styleClass="trend-blue" />
                </HBox>
                <Label text="MONTHLY LISTENERS" styleClass="metric-label" />
                <Label fx:id="lblMonthlyListeners" text="Loading..." styleClass="metric-value" />
                <Pane prefHeight="48.0" styleClass="listener-wave" />
            </VBox>

            <!-- Followers Growth -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="metric-card">
                <HBox alignment="CENTER_LEFT">
                    <StackPane prefWidth="34.0" prefHeight="30.0" styleClass="metric-icon growth-icon">
                        <Label text="↗" />
                    </StackPane>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblTrendFollowers" text="—" styleClass="trend-neutral" />
                </HBox>
                <Label text="FOLLOWERS GROWTH" styleClass="metric-label" />
                <Label fx:id="lblFollowersGrowth" text="—" styleClass="metric-value" />
                <HBox alignment="BOTTOM_LEFT" spacing="7.0" styleClass="followers-bars">
                    <Region prefWidth="7.0" prefHeight="13.0" />
                    <Region prefWidth="7.0" prefHeight="22.0" />
                    <Region prefWidth="7.0" prefHeight="30.0" />
                    <Region prefWidth="7.0" prefHeight="25.0" />
                    <Region prefWidth="7.0" prefHeight="40.0" />
                    <Region prefWidth="7.0" prefHeight="48.0" />
                </HBox>
            </VBox>
        </HBox>

        <!-- ── Content Library ── -->
        <VBox spacing="12.0" styleClass="admin-panel">

            <GridPane fx:id="contentTable" hgap="18.0" vgap="16.0" styleClass="admin-table">
                <columnConstraints>
                    <ColumnConstraints percentWidth="38.0" />
                    <ColumnConstraints percentWidth="20.0" />
                    <ColumnConstraints percentWidth="17.0" />
                    <ColumnConstraints percentWidth="17.0" />
                    <ColumnConstraints percentWidth="8.0" />
                </columnConstraints>

                <!-- Header row — static, never removed -->
                <Label text="TRACK / ALBUM"  GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="table-head" />
                <Label text="RELEASE DATE"   GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="table-head" />
                <Label text="STATUS"         GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="table-head" />
                <Label text="STREAMS"        GridPane.rowIndex="0" GridPane.columnIndex="3" styleClass="table-head" />
                <Label text="ACTIONS"        GridPane.rowIndex="0" GridPane.columnIndex="4" styleClass="table-head" />
            </GridPane>

            <Button fx:id="btnLibraryCount"
                    text="View All Content Library"
                    styleClass="chart-button" />
        </VBox>

    </VBox>
</ScrollPane>