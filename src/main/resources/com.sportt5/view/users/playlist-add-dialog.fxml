<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="pl-dialog-pane">

    <content>
        <VBox spacing="18" prefWidth="380" styleClass="pl-dialog-body">

            <Label text="New Playlist" styleClass="pl-dialog-title" />

            <!-- Cover preview -->
            <StackPane alignment="CENTER">
                <StackPane styleClass="pl-cover-frame pl-cover-frame-large"
                           prefWidth="120" prefHeight="120"
                           minWidth="120" minHeight="120">
                    <ImageView fx:id="coverPreview" fitWidth="120" fitHeight="120"
                               preserveRatio="false" />
                    <Label text="♪" styleClass="pl-cover-placeholder pl-cover-placeholder-large" />
                </StackPane>
            </StackPane>

            <!-- Fields -->
            <VBox spacing="10">
                <Label text="Playlist Name" styleClass="pl-field-label" />
                <TextField fx:id="nameField" promptText="Enter playlist name..."
                           styleClass="pl-text-field" />

                <Label text="Cover URL" styleClass="pl-field-label" />
                <TextField fx:id="coverUrlField" promptText="https://..."
                           styleClass="pl-text-field" />
            </VBox>

            <!-- Action buttons -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Cancel" styleClass="pl-btn-cancel" fx:id="cancelBtn" />
                <Button text="Create" styleClass="pl-btn-save" fx:id="createBtn" />
            </HBox>

        </VBox>
    </content>

</DialogPane>
