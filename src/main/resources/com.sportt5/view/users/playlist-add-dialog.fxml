<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<DialogPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="pl-dialog-pane">

    <content>
        <VBox styleClass="pl-dialog-body">

            <!-- Header -->
            <VBox styleClass="pl-dialog-header" alignment="CENTER">
                <StackPane styleClass="pl-dialog-icon-wrap">
                    <Label text="♪" styleClass="pl-dialog-icon" />
                </StackPane>
                <Label text="New Playlist" styleClass="pl-dialog-title" />
                <Label text="Give your playlist a name to get started."
                       styleClass="pl-dialog-subtitle" wrapText="true" />
            </VBox>

            <!-- Divider -->
            <Region styleClass="pl-dialog-divider" />

            <!-- Fields -->
            <VBox styleClass="pl-dialog-fields" spacing="6">
                <Label text="PLAYLIST NAME" styleClass="pl-field-label" />
                <TextField fx:id="nameField" promptText="My Playlist..."
                           styleClass="pl-text-field" />
            </VBox>

            <!-- Buttons -->
            <HBox styleClass="pl-dialog-actions" spacing="10">
                <Button text="Cancel" styleClass="pl-btn-cancel" fx:id="cancelBtn"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button text="Create" styleClass="pl-btn-save" fx:id="createBtn"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>

        </VBox>
    </content>

</DialogPane>
