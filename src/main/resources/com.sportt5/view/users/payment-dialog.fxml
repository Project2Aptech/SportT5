<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sportt5.controller.components.PaymentController">

    <content>

        <VBox alignment="CENTER"
              spacing="15"
              prefWidth="350"
              prefHeight="420">

            <Label fx:id="planLabel"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <ImageView fx:id="qrImageView"
                       fitWidth="220"
                       fitHeight="220"
                       preserveRatio="true"/>

            <Label text="Scan the QR code to make a payment"/>

            <ProgressIndicator fx:id="loadingSpinner"
                               visible="false"/>

            <Label fx:id="errorLabel"
                   visible="false"
                   style="-fx-text-fill: red;"/>

            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="confirmBtn" text="Confirm"
                        onAction="#onConfirm"/>

                <Button text="Cancel"
                        onAction="#onCancel"/>
            </HBox>

        </VBox>

    </content>

</DialogPane>