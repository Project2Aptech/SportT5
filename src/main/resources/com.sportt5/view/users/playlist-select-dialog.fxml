<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="pl-dialog-pane">

    <content>
        <VBox spacing="16" prefWidth="320" styleClass="pl-dialog-body">

            <Label text="Add to Playlist" styleClass="pl-dialog-title" />

            <VBox spacing="6">
                <Label text="Select Playlist" styleClass="pl-field-label" />
                <ComboBox fx:id="playlistComboBox" promptText="Choose a playlist..."
                          maxWidth="Infinity" styleClass="lib-combo" />
            </VBox>

            <!-- Action buttons -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Cancel" styleClass="pl-btn-cancel" fx:id="cancelBtn" />
                <Button text="Add" styleClass="pl-btn-save" fx:id="addBtn" />
            </HBox>

        </VBox>
    </content>

</DialogPane>
