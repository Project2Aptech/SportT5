<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="pl-dialog-pane">

    <content>
        <VBox spacing="20" prefWidth="340" alignment="CENTER" styleClass="pl-dialog-body">

            <Label text="🗑" styleClass="pl-delete-icon" />
            <Label text="Delete Playlist?" styleClass="pl-dialog-title" />
            <Label fx:id="confirmMessage"
                   text="Are you sure you want to delete this playlist? This action cannot be undone."
                   styleClass="pl-delete-desc"
                   wrapText="true" textAlignment="CENTER" />

            <HBox spacing="12" alignment="CENTER">
                <Button text="Cancel" styleClass="pl-btn-cancel" fx:id="cancelBtn" />
                <Button text="Delete" styleClass="pl-btn-delete" fx:id="deleteBtn" />
            </HBox>

        </VBox>
    </content>

</DialogPane>
