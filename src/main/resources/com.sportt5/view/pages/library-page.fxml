<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sportt5.controller.pages.LibraryController"
            visible="false" managed="false"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER" styleClass="home-scroll">
    <VBox spacing="24.0" styleClass="library-body">
        <Label text="My Library" styleClass="library-heading" />

        <!-- Tab bar -->
        <HBox spacing="28.0" styleClass="library-tabs">
            <Label fx:id="tabPlaylists"  text="Playlists"   styleClass="library-tab-active" />
            <Label fx:id="tabGenres"     text="Genres"      styleClass="library-tab" />
            <Label fx:id="tabArtists"    text="Artists"     styleClass="library-tab" />
            <Label fx:id="tabAlbums"     text="Albums"      styleClass="library-tab" />
            <Label fx:id="tabDownloaded" text="Downloaded"  styleClass="library-tab" />
        </HBox>

        <!-- === PLAYLISTS VIEW === -->
        <VBox fx:id="playlistsView" spacing="24.0">
            <HBox spacing="22.0">
                <StackPane fx:id="likedBtn" prefWidth="250.0" prefHeight="165.0"
                           minHeight="165.0" maxHeight="165.0" styleClass="liked-card">
                    <VBox alignment="CENTER_LEFT" spacing="4.0" StackPane.alignment="CENTER_LEFT">
                        <Label text="♥" styleClass="liked-heart" />
                        <Label text="Liked Songs" styleClass="liked-title" />
                        <Label fx:id="favouritesCount" text="0 songs" styleClass="liked-count" />
                    </VBox>
                </StackPane>
                <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Your Playlists" styleClass="store-section-title" />
                    </HBox>
                    <ScrollPane styleClass="playlist-h-scroll" hbarPolicy="NEVER" vbarPolicy="NEVER"
                                fitToHeight="true" pannable="true">
                        <HBox fx:id="playlistCardsBox" spacing="14.0" style="-fx-padding: 2 2 6 2;"/>
                    </ScrollPane>
                </VBox>
            </HBox>

            <VBox spacing="14.0">
                <Label fx:id="playlistSongsTitle" text="Playlist's Songs" styleClass="store-section-title" />
                <GridPane fx:id="playlistSongsTable" hgap="18.0" vgap="15.0" styleClass="recent-table">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="8.0" />
                        <ColumnConstraints percentWidth="28.0" />
                        <ColumnConstraints percentWidth="28.0" />
                        <ColumnConstraints percentWidth="22.0" />
                        <ColumnConstraints percentWidth="8.0" />
                        <ColumnConstraints percentWidth="6.0" />
                    </columnConstraints>
                    <Label text="#"          GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="table-head" />
                    <Label text="TITLE"      GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="table-head" />
                    <Label text="ALBUM"      GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="table-head" />
                    <Label text="DATE ADDED" GridPane.rowIndex="0" GridPane.columnIndex="3" styleClass="table-head" fx:id="dateAdded"/>
                    <Label text="DURATION"   GridPane.rowIndex="0" GridPane.columnIndex="4" styleClass="table-head" />
                    <Label text="ACTIONS"    GridPane.rowIndex="0" GridPane.columnIndex="5" styleClass="table-head" />
                </GridPane>
            </VBox>
        </VBox>

        <!-- === GENRES VIEW === -->
        <VBox fx:id="genresView" visible="false" managed="false" spacing="18.0">
            <FlowPane fx:id="genreChipsBox" hgap="10.0" vgap="10.0"/>
            <HBox alignment="CENTER_LEFT">
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="songCountLabel" styleClass="table-text" />
            </HBox>
            <GridPane fx:id="songListTable" hgap="18.0" vgap="15.0" styleClass="recent-table">
                <columnConstraints>
                    <ColumnConstraints percentWidth="8.0" />
                    <ColumnConstraints percentWidth="28.0" />
                    <ColumnConstraints percentWidth="28.0" />
                    <ColumnConstraints percentWidth="22.0" />
                    <ColumnConstraints percentWidth="8.0" />
                    <ColumnConstraints percentWidth="6.0" />
                </columnConstraints>
                <Label text="#"          GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="table-head" />
                <Label text="TITLE"      GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="table-head" />
                <Label text="ALBUM"      GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="table-head" />
                <Label text="DATE ADDED" GridPane.rowIndex="0" GridPane.columnIndex="3" styleClass="table-head" />
                <Label text="DURATION"   GridPane.rowIndex="0" GridPane.columnIndex="4" styleClass="table-head" />
                <Label text="ACTIONS"    GridPane.rowIndex="0" GridPane.columnIndex="5" styleClass="table-head" />
            </GridPane>
        </VBox>

        <!-- === ARTISTS VIEW === -->
        <VBox fx:id="artistsView" visible="false" managed="false" spacing="20.0">
            <ComboBox fx:id="artistComboBox" promptText="Choose an artist..."
                      prefWidth="320.0" styleClass="lib-combo" />
            <HBox spacing="24.0" styleClass="lib-detail-box">
                <!-- Avatar -->
                <StackPane prefWidth="120.0" prefHeight="120.0" styleClass="lib-avatar-frame">
                    <ImageView fx:id="artistAvatarImg" fitWidth="120.0" fitHeight="120.0" preserveRatio="true" />
                </StackPane>
                <!-- Info -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="artistNameLabel"      text="—"             styleClass="lib-detail-title" />
                    <Label fx:id="artistFollowersLabel" text="Followers: —"  styleClass="lib-detail-meta" />
                    <Label fx:id="artistSongsLabel"     text="Songs: —"      styleClass="lib-detail-meta" />
                    <Label fx:id="artistAlbumsLabel"    text="Albums: —"     styleClass="lib-detail-meta" />
                </VBox>
            </HBox>
            <GridPane fx:id="artistSongTable" hgap="18.0" vgap="15.0" styleClass="recent-table">
                <columnConstraints>
                    <ColumnConstraints percentWidth="8.0" />
                    <ColumnConstraints percentWidth="32.0" />
                    <ColumnConstraints percentWidth="32.0" />
                    <ColumnConstraints percentWidth="0.0" />
                    <ColumnConstraints percentWidth="10.0" />
                    <ColumnConstraints percentWidth="6.0" />
                </columnConstraints>
                <Label text="#"        GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="table-head" />
                <Label text="TITLE"    GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="table-head" />
                <Label text="ALBUM"    GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="table-head" />
                <Label text="DURATION" GridPane.rowIndex="0" GridPane.columnIndex="4" styleClass="table-head" />
                <Label text="ACTIONS"  GridPane.rowIndex="0" GridPane.columnIndex="5" styleClass="table-head" />
            </GridPane>
        </VBox>

        <!-- === ALBUMS VIEW === -->
        <VBox fx:id="albumsView" visible="false" managed="false" spacing="20.0">
            <ComboBox fx:id="albumComboBox" promptText="Choose an album..."
                      prefWidth="320.0" styleClass="lib-combo" />
            <HBox spacing="24.0" styleClass="lib-detail-box">
                <!-- Cover -->
                <StackPane prefWidth="160.0" prefHeight="160.0" styleClass="lib-cover-frame">
                    <ImageView fx:id="albumCoverImg" fitWidth="160.0" fitHeight="160.0" preserveRatio="true" />
                </StackPane>
                <!-- Info -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="albumTitleLabel"    text="—"           styleClass="lib-detail-title" />
                    <Label fx:id="albumArtistLabel"   text="Artist: —"   styleClass="lib-detail-meta" />
                    <Label fx:id="albumYearLabel"     text="Year: —"     styleClass="lib-detail-meta" />
                    <Label fx:id="albumSongsLabel"    text="Songs: —"    styleClass="lib-detail-meta" />
                    <Label fx:id="albumDurationLabel" text="Duration: —" styleClass="lib-detail-meta" />
                </VBox>
            </HBox>
            <GridPane fx:id="albumSongTable" hgap="18.0" vgap="15.0" styleClass="recent-table">
                <columnConstraints>
                    <ColumnConstraints percentWidth="8.0" />
                    <ColumnConstraints percentWidth="32.0" />
                    <ColumnConstraints percentWidth="32.0" />
                    <ColumnConstraints percentWidth="0.0" />
                    <ColumnConstraints percentWidth="10.0" />
                    <ColumnConstraints percentWidth="6.0" />
                </columnConstraints>
                <Label text="#"        GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="table-head" />
                <Label text="TITLE"    GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="table-head" />
                <Label text="ARTIST"   GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="table-head" />
                <Label text="DURATION" GridPane.rowIndex="0" GridPane.columnIndex="4" styleClass="table-head" />
                <Label text="ACTIONS"  GridPane.rowIndex="0" GridPane.columnIndex="5" styleClass="table-head" />
            </GridPane>
        </VBox>

    </VBox>
</ScrollPane>
