<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sportt5.controller.components.ResetPasswordController"
      alignment="CENTER"
      spacing="15"
      prefWidth="450"
      prefHeight="320"
      styleClass="forgot-root">

    <Label text="Reset Password"
           styleClass="forgot-title"/>

    <TextField fx:id="tokenField"
               promptText="Paste token from email"
               maxWidth="320"
               styleClass="forgot-field"/>

    <PasswordField fx:id="passwordField"
                   promptText="New Password"
                   maxWidth="320"
                   styleClass="forgot-field"/>

    <PasswordField fx:id="confirmPasswordField"
                   promptText="Confirm Password"
                   maxWidth="320"
                   styleClass="forgot-field"/>

    <Label fx:id="errorText"
           text=""
           styleClass="error-label"/>

    <HBox alignment="CENTER" spacing="10">
        <Button text="Confirm"
                onAction="#handleConfirm"
                styleClass="continue-btn"/>

        <Button text="Cancel"
                onAction="#handleCancel"
                styleClass="cancel-btn"/>
    </HBox>

</VBox>