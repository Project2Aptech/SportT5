<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sportt5.controller.components.ForgotPasswordController"
      alignment="CENTER"
      spacing="15"
      prefWidth="400"
      prefHeight="220"
      styleClass="forgot-root">

    <Label text="Forgot Password"
           styleClass="forgot-title"/>

    <TextField fx:id="emailField"
               promptText="Enter your email"
               styleClass="forgot-field"/>

    <Label fx:id="errorText"
           text=""
           styleClass="error-label"/>

    <HBox alignment="CENTER" spacing="10">
        <Button text="Continue"
                onAction="#handleContinue"
                styleClass="continue-btn"/>

        <Button text="Cancel"
                onAction="#handleCancel"
                styleClass="cancel-btn"/>
    </HBox>
</VBox>
